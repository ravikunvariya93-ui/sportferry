# ──────────────────────────────────────────
# Sportferry — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in values.

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=

# NextAuth secret — must be a random string of at least 32 characters in production
# Generate one: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of your app (required in production)
# Examples:
#   http://localhost:3000          (local dev)
#   https://sportferry.com         (production)
NEXTAUTH_URL=

# Vercel Blob token for venue image uploads (cover + gallery)
# Create one: Vercel Dashboard → Storage → Blob → Create → copy READ_WRITE token
# Then add to .env.local:  BLOB_READ_WRITE_TOKEN=vercel_blob_...
BLOB_READ_WRITE_TOKEN=

# Razorpay webhook secret — confirms bookings when the player closes the
# browser after paying, and refunds payments whose hold expired.
# Razorpay Dashboard → Accounts & Settings → Webhooks → Add New Webhook
# URL: https://sportferry.com/api/payments/webhook, event: payment.captured.
# The secret is one you choose in that form — it is NOT your API key secret.
RAZORPAY_WEBHOOK_SECRET=
